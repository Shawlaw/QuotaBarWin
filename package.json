{
  "name": "quotabarwin",
  "version": "1.2.3",
  "description": "Windows-only desktop app for monitoring AI usage and quota windows.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shawlaw/QuotaBarWin.git"
  },
  "bugs": {
    "url": "https://github.com/Shawlaw/QuotaBarWin/issues"
  },
  "homepage": "https://github.com/Shawlaw/QuotaBarWin#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "e2e": "node e2e/tauri.e2e.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "test": "vitest",
    "smoke": "vitest --run src/smoke.test.tsx",
    "tauri": "tauri"
  },
  "overrides": {
    "esbuild": "0.27.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "edgedriver": "^6.3.0",
    "jsdom": "^27.0.0",
    "vitest": "^3.0.0",
    "webdriverio": "^9.27.2"
  }
