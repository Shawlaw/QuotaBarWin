{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaBarWin",
  "version": "1.0.0",
  "identifier": "com.quotabarwin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuotaBarWin V1.0.0",
        "label": "main",
        "width": 760,
        "height": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
