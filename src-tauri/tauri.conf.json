{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaBarWin",
  "version": "0.0.0",
  "identifier": "com.quotabarwin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuotaBarWin",
        "label": "main",
        "width": 760,
        "height": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MERCODVDQkYzMzU2MQpSV1JoTmZQTGhkdUFCK2l4QW1DaFYwNjl5c3hndDNxNm1IbkdPUWtLY2hnbkc5emNjNTNybEwyZwo=",
      "endpoints": [
        "https://github.com/owner/QuotaBarWin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
