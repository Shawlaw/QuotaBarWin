{
  "schemaVersion": 2,
  "id": "example-minimal",
  "displayName": "Example Minimal Provider",
  "version": "1.0.0",
  "minAppVersion": "1.1.0",
  "description": "A minimal embedded JavaScript provider manifest. Copy it, declare every capability, and compute the SHA-256 of provider.js.",
  "runtime": "builtin-js",
  "entry": "provider.js",
  "requiredEnvVars": [],
  "output": "provider-snapshot-v1",
  "permissions": [],
  "defaultConfig": {
    "name": "Example",
    "timeoutSeconds": 30,
    "visibleWindowIds": [],
    "windowLabelOverrides": {},
    "envVars": {}
  },
  "parameters": [
    {
      "name": "EXAMPLE_API_KEY",
      "label": "Example API Key",
      "kind": "secret",
      "required": false,
      "defaultValue": "${secret:EXAMPLE_API_KEY}",
      "description": "Optional example parameter hint shown in Settings."
    }
  ],
  "checksums": {
    "source": "sha256:<replace-with-sha256-of-provider.js>"
  }
}
